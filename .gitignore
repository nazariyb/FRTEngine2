# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Compiled binaries
/Binaries/*
/Intermediate/*
/Core/Content/Shaders/Bin

# Precompiled Headers
*.gch
*.pch

# Executables
*.out
*.app

# IDE
.vs/*
.idea/*

# Generated project files
*.sln
**/*.vcxproj
**/*.vcxproj.filters
**/*.vcxproj.user
**/*.DotSettings.user

# The engine checkout's untracked files: remembered generation options, the editor's own files
# (Local/Editor: layout, input overrides, project manager), what runs without a project write.
# A project's captures and profiling sessions are in its own Local/ (see below for templates).
/Local/

# Templates built in place (FRT.bat generate --project=Templates/<Name>)
/Templates/*/Binaries/
/Templates/*/Intermediate/
/Templates/*/Local/

# Prebuilt third-party libraries (premake5 fetch-thirdparty)
/ThirdParty/Prebuilt
