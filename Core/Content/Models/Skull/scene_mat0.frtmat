version: 1
# FRT material
name: defaultMat
vertex_shader: VertexShader
pixel_shader: PixelShader
color: RGBA(1.0, 0.843, 1.0, 1.0)
metallic: 1
roughness: 0
emissive: RGBA(0, 0, 0, 1)
emissive_intensity: 0
base_color_texture: textures\defaultMat_baseColor.jpeg
cull: front
depth_enable: true
depth_write: true
depth_func: less
alpha_blend: false
