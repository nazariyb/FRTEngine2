# Generated Unicode tables are byte-exact outputs of Tools/Unicode/GenerateUnicodeTables.py,
# which writes LF; its --check compares them with what it would generate.
*.generated.h text eol=lf
*.generated.inl text eol=lf

# Text the engine hashes - asset metadata, documents, rules, tables, config, shader sources - has
# the same bytes in every working copy: content hashes are over the raw bytes on disk, so a CRLF
# checkout (core.autocrlf=true, Git for Windows' default) and an LF one would key the same file
# differently. LF in the index and in every working tree, whatever core.autocrlf says. FRT.bat
# setup re-checks-out the files a working tree still has with CRLF, and FRT.bat verify checks
# that none is left. Templates/Common/.gitattributes gives projects the same rules.
#
# Everything under a content folder is first never converted, so a file of a kind listed nowhere
# here (a license.txt, a README.md, a .obj beside a model) reaches the scan, its FILES row and the
# registry dump with the committed bytes; the rules below then make the known text kinds LF.
Core/Content/** -text
Templates/*/Content/** -text
Templates/*/Plugins/*/Content/** -text
*.meta text eol=lf
*.yml text eol=lf
*.frt text eol=lf
*.csv text eol=lf
*.ini text eol=lf
*.hlsl text eol=lf
*.hlsli text eol=lf
# The input documents of today, until they become .frt documents.
*.frtinputmap text eol=lf
*.frtinputaction text eol=lf
# Every shader file, Shared/*.h included, is hashed into the keys of the programs that use it.
Core/Content/Shaders/** text eol=lf

# The registry's golden dumps (FRT.bat verify --update-goldens writes them with LF): Core-Test and verify compare
# them line for line, and LF keeps them byte-identical to the dump in every working copy.
Core-Test/Assets/Golden/** text eol=lf

# Text formats the engine only imports reach the importer byte for byte as committed.
*.gltf -text

# cmd.exe reads batch files with CRLF line endings; with LF it can misparse labels and blocks.
*.bat eol=crlf

# Binary sources: never converted, diffed or merged as text, whatever their bytes look like.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.exr binary
*.hdr binary
*.dds binary
*.glb binary
*.bin binary
*.psd binary
*.kra binary
*.blend binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
