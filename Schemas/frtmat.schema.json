{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FRT Material",
  "description": "FRTEngine2 material asset (.frtmat.yml)",
  "type": "object",
  "$defs": {
    "colorLDR": {
      "type": "object",
      "description": "LDR color, each channel clamped to [0, 1]",
      "additionalProperties": false,
      "properties": {
        "r": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Red channel [0, 1]"
        },
        "g": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Green channel [0, 1]"
        },
        "b": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Blue channel [0, 1]"
        },
        "a": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Alpha channel [0, 1]"
        }
      }
    },
    "colorHDR": {
      "type": "object",
      "description": "HDR color, channels >= 0 (no upper bound)",
      "additionalProperties": false,
      "properties": {
        "r": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Red channel"
        },
        "g": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Green channel"
        },
        "b": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Blue channel"
        },
        "a": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "description": "Alpha channel"
        }
      }
    }
  },
  "required": [
    "version",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        2,
        3
      ],
      "description": "Asset format version. 3 is written; 2 is read (subset of 3)."
    },
    "name": {
      "type": "string",
      "description": "Material name"
    },
    "shaders": {
      "type": "object",
      "description": "Shader programs used by this material",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "vertex": {
          "type": "string",
          "description": "Vertex shader name"
        },
        "pixel": {
          "type": "string",
          "description": "Pixel shader name"
        }
      }
    },
    "albedo": {
      "type": "object",
      "description": "Base color. When texture is present, color acts as a tint multiplier.",
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/colorLDR",
          "description": "Tint color (LDR). Default: white { r: 1, g: 1, b: 1, a: 1 }."
        },
        "texture": {
          "type": "string",
          "description": "Path to base color texture, relative to the material file"
        }
      }
    },
    "metallic": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0,
      "description": "Metallic factor [0, 1]. Default: 0."
    },
    "roughness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "Roughness factor [0, 1]. Default: 1."
    },
    "emissive": {
      "type": "object",
      "description": "Emissive light emission",
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/colorHDR",
          "description": "Emissive color (HDR). Default: black { r: 0, g: 0, b: 0 }."
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Emissive intensity multiplier. Default: 0."
        },
        "texture": {
          "type": "string",
          "description": "Emissive texture (sRGB), relative to the material file; multiplies color * intensity"
        }
      }
    },
    "depth": {
      "type": "object",
      "description": "Depth buffer settings",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable depth testing. Default: true."
        },
        "write": {
          "type": "boolean",
          "default": true,
          "description": "Enable depth writes. Default: true."
        },
        "func": {
          "type": "string",
          "enum": [
            "less",
            "less_equal",
            "equal",
            "greater",
            "greater_equal",
            "always",
            "never"
          ],
          "default": "less",
          "description": "Depth comparison function. Default: less."
        }
      }
    },
    "cull": {
      "type": "string",
      "enum": [
        "none",
        "front",
        "back"
      ],
      "default": "none",
      "description": "Face culling mode. Default: none."
    },
    "blend": {
      "type": "object",
      "description": "Blend settings",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false,
          "description": "Enable alpha blending. Default: false."
        }
      }
    },
    "metallicRoughnessTexture": {
      "type": "string",
      "description": "glTF metallic-roughness texture (G = roughness, B = metallic), relative to the material file; multiplies the factors"
    },
    "normal": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tangent-space normal map",
      "properties": {
        "texture": {
          "type": "string",
          "description": "Normal map (linear), relative to the material file"
        },
        "scale": {
          "type": "number",
          "default": 1,
          "description": "Normal XY scale"
        }
      }
    },
    "occlusion": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ambient occlusion (raster preview only)",
      "properties": {
        "texture": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      }
    },
    "alpha": {
      "type": "object",
      "additionalProperties": false,
      "description": "Transparency (glTF alphaMode)",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "opaque",
            "mask",
            "blend"
          ],
          "default": "opaque",
          "description": "mask = alpha test, blend = stochastic transparency in the path tracer"
        },
        "cutoff": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "doubleSided": {
      "type": "boolean",
      "default": false,
      "description": "glTF doubleSided"
    },
    "specular": {
      "type": "object",
      "additionalProperties": false,
      "description": "KHR_materials_specular / ior / transmission",
      "properties": {
        "factor": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "description": "Scales dielectric F0 (0.04)"
        },
        "ior": {
          "type": "number",
          "minimum": 1,
          "default": 1.5
        },
        "transmission": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Reserved (not yet rendered)"
        }
      }
    }
  }
}