# Sourced by FRT's git hooks (Docs/Assets.md, "Version control"); not a hook itself, as git runs only files
# named after one. core.hooksPath, which FRT.bat setup --hooks points here, makes git look for every hook in
# this folder and nowhere else, so the clone's own hooks in .git/hooks (Git LFS's, the person's) would stop
# running without a word, and a push would carry LFS pointers without their objects. Each hook here passes
# on to them.
#
# chainHook <name> [arguments]: runs <common git dir>/hooks/<name> (a worktree's too: the common one is the
# clone's) with the same arguments and stdin, when it is there and executable, and returns its status. Else,
# for the four hooks Git LFS installs, `git lfs <name>`, which is all LFS's own hook files do, when the clone
# uses LFS (its filter is configured and a .gitattributes in the index names it): so LFS works whether it was
# installed before setup --hooks or after, when its hook files had nowhere to go. Else 0.
chainHook ()
{
	local name=$1
	shift
	local commonDir
	commonDir=$(git rev-parse --git-common-dir) || return 1
	local own="$commonDir/hooks/$name"
	if [ -f "$own" ] && [ -x "$own" ] && ! [ "$own" -ef "$0" ]; then
		"$own" "$@"
		return
	fi
	case "$name" in
		pre-push|post-checkout|post-commit|post-merge) ;;
		*) return 0 ;;
	esac
	if ! git config --get filter.lfs.process > /dev/null 2>&1 \
		|| ! git grep --cached -q -e 'filter=lfs' -- '.gitattributes' '*/.gitattributes' 2> /dev/null; then
		return 0
	fi
	if ! command -v git-lfs > /dev/null 2>&1; then
		echo >&2 "This repository uses Git LFS, but git-lfs is not on PATH ($name): install it, or git push --no-verify."
		return 2
	fi
	git lfs "$name" "$@"
}
